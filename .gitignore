# ---- Wiesbaden-Survivors-Webbasis (Klon) ----
# 归档大文件不入库（可选放开）
# archive/*.html

*.log
.DS_Store
Thumbs.db
server.pid

# Playwright-Runner (Screenshots/Logs bei Fehlschlag)
test-results/
node_modules/
*.blend1
__pycache__/

# engine.js.bak: Backup von split-engine.js
*.bak

# ---- Unreal Engine (GitHub-Template), auch fuer Projekte in Unterordnern ----
Unreal/**/Binaries/
Unreal/**/Intermediate/
Unreal/**/Saved/
Unreal/**/DerivedDataCache/
*.slnx

# ---- Unreal Engine (GitHub-Template) ----
# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*
